# GEMINI_API_KEY: Required for Gemini AI API calls (e.g. Gemini 3.7 Flash)
GEMINI_API_KEY=

# TELEGRAM_BOT_TOKEN: Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=

# TELEGRAM_CHAT_ID: Target Telegram channel or chat ID (e.g. @System_S1_Channel or -1001234567890)
TELEGRAM_CHAT_ID=

# APP_URL: Optional app hosting URL
APP_URL=
